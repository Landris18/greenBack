FROM python:3.12

WORKDIR /srv

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential \
        git \
        vim \
        curl \
        wget \
        procps \
        net-tools \
        iputils-ping \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir numpy pandas requests

COPY app/ /srv/

CMD ["python", "server.py"]
