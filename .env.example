APP_ENV=local
APP_NAME=GreenSI
DEBUG=false

SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=greensi
DATABASE_USER=greensi
DATABASE_PASSWORD=greensi
DATABASE_EXPOSED_PORT=5433

API_PORT=8000
FRONT_PORT=3000
VITE_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DOCKER_HOST=tcp://docker-socket-proxy:2375
DOCKER_TIMEOUT_SECONDS=10
COLLECTOR_INTERVAL_SECONDS=30
COLLECTOR_MAX_CONCURRENCY=8
COLLECTOR_HOST_NAME=machine-locale
SYSFS_PATH=/hostsys
# Renseigne par scripts/activer-mesure-rapl.sh, laisser tel quel sinon.
RAPL_GID=1000
BMC_REDFISH_URL=
BMC_USERNAME=
BMC_PASSWORD=
BMC_VERIFY_TLS=true
PROCFS_PATH=/host/proc
# Racine ou GreenSI cherche les fichiers docker-compose de vos projets.
# scripts/initialiser.sh y place votre dossier personnel.
PROJECTS_ROOT=/home
# Renseignes automatiquement par scripts/initialiser.sh.
HOST_UID=1000
HOST_GID=1000

SEED_ADMIN_EMAIL=admin@greensi.fr
SEED_ADMIN_PASSWORD=greensi2026
SEED_ADMIN_NAME=Administrateur
